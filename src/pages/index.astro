---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
const works = (await getCollection('works')).sort((a, b) => b.data.updatedAt.valueOf() - a.data.updatedAt.valueOf());
const base = import.meta.env.BASE_URL;
const active = works.filter((work) => work.data.status !== 'planned').length;
const published = works.filter((work) => work.data.status === 'published').length;
---
<BaseLayout>
  <section class="hero container">
    <div class="hero-copy">
      <span class="eyebrow">Open Korean Classics</span>
      <h1>우리 고전을,<br /><em>다시 읽을 수 있게.</em></h1>
      <p>아직 널리 번역되지 않은 한국 고전을 AI로 초벌 번역하고, 출처와 검수 상태를 투명하게 기록하며 공개합니다.</p>
      <div class="actions">
        <a class="primary" href={`${base}works/`}>고전 둘러보기</a>
        <a class="secondary" href={`${base}about/`}>프로젝트 원칙</a>
      </div>
    </div>
    <aside class="hero-card glass">
      <span class="eyebrow">ARCHIVE / 001</span>
      <div class="big-hanja">古典</div>
      <p>원문은 보존하고,<br />번역은 열어 두고,<br />수정의 기록은 남깁니다.</p>
      <div class="mini-stats"><span><strong>{works.length}</strong>등록 작품</span><span><strong>{active}</strong>진행 중</span><span><strong>{published}</strong>공개 완료</span></div>
    </aside>
  </section>

  <section class="container section">
    <div class="section-head"><div><span class="eyebrow">RECENT WORKS</span><h2 class="section-title">최근 고전</h2></div><a href={`${base}works/`} class="more">전체 보기 →</a></div>
    <div class="works-grid">{works.slice(0, 3).map((work) => <WorkCard work={work} />)}</div>
  </section>

  <section class="container principles glass">
    <div><span class="eyebrow">PRINCIPLES</span><h2>AI 번역을 정답처럼<br />보여주지 않습니다.</h2></div>
    <div class="principle-grid">
      <article><b>01</b><h3>출처를 남깁니다</h3><p>원문 출처와 이용 조건을 작품마다 기록합니다.</p></article>
      <article><b>02</b><h3>검수 상태를 표시합니다</h3><p>AI 초벌, 사람 검토, 공개 완료를 구분합니다.</p></article>
      <article><b>03</b><h3>수정에 열려 있습니다</h3><p>GitHub 이력과 기여를 통해 번역을 계속 다듬습니다.</p></article>
    </div>
  </section>
</BaseLayout>
<style>
  .hero { padding: 92px 0 54px; display: grid; grid-template-columns: 1.45fr .8fr; gap: 28px; align-items: stretch; }
  .hero-copy { padding: 34px 8px; }
  h1 { margin: 12px 0 20px; font-size: clamp(3rem, 8vw, 6.6rem); line-height: .98; letter-spacing: -.075em; font-weight: 860; }
  h1 em { color: var(--accent); font-style: normal; font-family: "Noto Serif KR", serif; font-weight: 700; }
  .hero-copy p { max-width: 640px; color: var(--muted); font-size: 1.05rem; }
  .actions { display: flex; gap: 10px; margin-top: 28px; }
  .actions a { padding: 13px 17px; border-radius: 14px; font-weight: 800; font-size: .9rem; }
  .primary { background: var(--accent); color: var(--bg); }
  .secondary { border: 1px solid var(--line); background: var(--surface); }
  .hero-card { border-radius: 32px; padding: 30px; display: flex; min-height: 430px; flex-direction: column; justify-content: space-between; }
  .big-hanja { font-size: clamp(4rem, 9vw, 7rem); font-family: serif; color: var(--accent); line-height: 1; }
  .hero-card > p { font-family: "Noto Serif KR", serif; font-size: 1.1rem; }
  .mini-stats { display: grid; grid-template-columns: repeat(3,1fr); gap: 8px; border-top: 1px solid var(--line); padding-top: 18px; }
  .mini-stats span { display: grid; color: var(--muted); font-size: .68rem; }
  .mini-stats strong { color: var(--text); font-size: 1.35rem; }
  .section { padding: 54px 0; }
  .section-head { display: flex; justify-content: space-between; align-items: end; margin-bottom: 22px; }
  .more { color: var(--accent); font-size: .88rem; font-weight: 800; }
  .works-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 18px; }
  .principles { margin-top: 48px; margin-bottom: 20px; border-radius: 32px; padding: 38px; display: grid; grid-template-columns: .8fr 1.5fr; gap: 36px; }
  .principles h2 { margin: 8px 0; font-size: clamp(1.8rem,4vw,3rem); line-height: 1.16; letter-spacing: -.05em; }
  .principle-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 16px; }
  .principle-grid article { padding: 4px 10px; }
  .principle-grid b { color: var(--accent); font-size: .78rem; }
  .principle-grid h3 { margin: 14px 0 8px; font-size: 1rem; }
  .principle-grid p { margin: 0; color: var(--muted); font-size: .86rem; }
  @media (max-width: 900px) { .hero { grid-template-columns: 1fr; padding-top: 56px; } .hero-card { min-height: 320px; } .works-grid { grid-template-columns: 1fr 1fr; } .principles { grid-template-columns: 1fr; } }
  @media (max-width: 620px) { .works-grid, .principle-grid { grid-template-columns: 1fr; } .hero-copy { padding-inline: 2px; } .principles { padding: 25px; } }
</style>
