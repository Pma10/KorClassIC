---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../../components/WorkCard.astro';
const works = (await getCollection('works')).sort((a, b) => b.data.updatedAt.valueOf() - a.data.updatedAt.valueOf());
---
<BaseLayout title="고전 · KorClassIC" description="KorClassIC에 등록된 한국 고전 번역 목록">
  <section class="container archive-head">
    <span class="eyebrow">CLASSICS ARCHIVE</span>
    <h1>고전 둘러보기</h1>
    <p>번역 예정부터 검토 완료까지, 각 작품의 현재 상태를 함께 공개합니다.</p>
    <div class="search glass"><span>⌕</span><input id="work-search" type="search" placeholder="작품명, 한자명, 저자, 시대 검색" autocomplete="off" /></div>
  </section>
  <section class="container">
    <div class="works-grid">{works.map((work) => <WorkCard work={work} />)}</div>
    <p id="empty" class="empty" hidden>검색 결과가 없습니다.</p>
  </section>
</BaseLayout>
<script>
  const input = document.querySelector<HTMLInputElement>('#work-search');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-work-card]')];
  const empty = document.querySelector<HTMLElement>('#empty');
  input?.addEventListener('input', () => {
    const query = input.value.trim().toLowerCase();
    let visible = 0;
    for (const card of cards) {
      const matched = !query || (card.dataset.search ?? '').includes(query);
      card.hidden = !matched;
      if (matched) visible++;
    }
    if (empty) empty.hidden = visible !== 0;
  });
</script>
<style>
  .archive-head { padding: 84px 0 34px; }
  h1 { margin: 8px 0 8px; font-size: clamp(2.6rem,7vw,5.2rem); letter-spacing: -.065em; }
  .archive-head > p { color: var(--muted); margin: 0 0 24px; }
  .search { max-width: 560px; border-radius: 16px; display: flex; align-items: center; gap: 10px; padding: 0 15px; }
  .search span { color: var(--muted); font-size: 1.25rem; }
  .search input { width: 100%; padding: 14px 0; color: var(--text); background: transparent; border: 0; outline: 0; }
  .works-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 18px; padding: 10px 0 38px; }
  .empty { text-align: center; padding: 80px 0; color: var(--muted); }
  @media (max-width: 900px) { .works-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 620px) { .works-grid { grid-template-columns: 1fr; } }
</style>
