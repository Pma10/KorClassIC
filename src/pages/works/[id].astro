---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const works = await getCollection('works');
  return works.map((work) => ({ params: { id: work.id }, props: { work } }));
}

const { work } = Astro.props;
const { Content } = await render(work);
const label = { planned: '번역 예정', translating: '번역 중', reviewing: '검토 중', published: '공개 완료' }[work.data.status];
---
<BaseLayout title={`${work.data.title} · KorClassIC`} description={work.data.summary}>
  <article class="container work-page">
    <header class="work-head glass">
      <div>
        <span class="eyebrow">{work.data.period} / {work.data.category}</span>
        {work.data.hanjaTitle && <div class="hanja">{work.data.hanjaTitle}</div>}
        <h1>{work.data.title}</h1>
        <p>{work.data.summary}</p>
      </div>
      <div class="status-panel">
        <span class="pill">{label}</span>
        <strong>{work.data.progress}%</strong>
        <div class="progress"><span style={`width:${work.data.progress}%`}></span></div>
        <small>마지막 갱신 {work.data.updatedAt.toLocaleDateString('ko-KR')}</small>
      </div>
    </header>

    <div class="content-grid">
      <aside class="meta glass">
        <h2>작품 정보</h2>
        <dl>
          {work.data.author && <><dt>저자</dt><dd>{work.data.author}</dd></>}
          <dt>시대</dt><dd>{work.data.period}</dd>
          <dt>분류</dt><dd>{work.data.category}</dd>
          {work.data.source && <><dt>원문 출처</dt><dd>{work.data.sourceUrl ? <a href={work.data.sourceUrl} target="_blank" rel="noreferrer">{work.data.source} ↗</a> : work.data.source}</dd></>}
          {work.data.sourceLicense && <><dt>원문 이용조건</dt><dd>{work.data.sourceLicense}</dd></>}
        </dl>
        <a class="github" href={`https://github.com/Pma10/KorClassIC/edit/main/src/content/works/${work.id}.md`} target="_blank" rel="noreferrer">GitHub에서 수정 제안 ↗</a>
      </aside>
      <section class="prose glass"><Content /></section>
    </div>
  </article>
</BaseLayout>
<style>
  .work-page { padding: 72px 0 20px; }
  .work-head { border-radius: 30px; padding: 38px; display: grid; grid-template-columns: 1fr 240px; gap: 30px; }
  .hanja { margin-top: 18px; color: var(--accent); font-family: serif; letter-spacing: .15em; font-size: 1.15rem; }
  h1 { margin: 2px 0 12px; font-size: clamp(2.5rem,6vw,5rem); letter-spacing: -.06em; }
  .work-head p { max-width: 680px; margin: 0; color: var(--muted); }
  .status-panel { border-left: 1px solid var(--line); padding-left: 28px; display: flex; flex-direction: column; justify-content: center; align-items: flex-start; }
  .status-panel strong { margin-top: 18px; font-size: 2.4rem; letter-spacing: -.06em; }
  .progress { width: 100%; height: 7px; background: var(--line); border-radius: 999px; overflow: hidden; }
  .progress span { display: block; height: 100%; background: var(--accent); border-radius: inherit; }
  .status-panel small { margin-top: 9px; color: var(--muted); }
  .content-grid { margin-top: 18px; display: grid; grid-template-columns: 270px 1fr; gap: 18px; align-items: start; }
  .meta, .prose { border-radius: 24px; padding: 26px; }
  .meta { position: sticky; top: 96px; }
  .meta h2 { margin-top: 0; font-size: 1rem; }
  dl { margin: 0; }
  dt { margin-top: 14px; color: var(--muted); font-size: .74rem; font-weight: 750; }
  dd { margin: 2px 0 0; font-size: .9rem; }
  dd a, .github { color: var(--accent); }
  .github { display: block; margin-top: 22px; padding-top: 18px; border-top: 1px solid var(--line); font-size: .8rem; font-weight: 800; }
  .prose :global(h2) { margin-top: 2.2em; font-size: 1.45rem; }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(blockquote) { margin: 20px 0; padding: 15px 18px; border-left: 3px solid var(--accent); background: var(--accent-soft); border-radius: 0 14px 14px 0; }
  .prose :global(code) { background: var(--accent-soft); padding: 2px 5px; border-radius: 6px; }
  @media (max-width: 820px) { .work-head, .content-grid { grid-template-columns: 1fr; } .status-panel { border-left: 0; border-top: 1px solid var(--line); padding: 24px 0 0; } .meta { position: static; } }
  @media (max-width: 600px) { .work-head { padding: 25px; } }
</style>
